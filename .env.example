# Copy this file to .env and fill in what you use. Never commit .env.

# Claude Agent: an Anthropic API key (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=

# Or run Claude through your company cloud instead of an API key (set one block).
# Amazon Bedrock:
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=eu-central-1
# Google Vertex AI:
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=europe-west1
# ANTHROPIC_VERTEX_PROJECT_ID=
# Microsoft Foundry:
# CLAUDE_CODE_USE_FOUNDRY=1

# GitHub Copilot CLI: planned, not part of this build yet (see docs/research/copilot-cli-1.0.105.md).
# When it arrives it will read a fine-grained token with the "Copilot Requests" permission here
# (classic ghp_ tokens do not work).
# COPILOT_GITHUB_TOKEN=
